# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

# Google Gemini API key (get one at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Gemini model to use for text-to-SQL generation
# Current stable options: gemini-3.6-flash, gemini-3.8-flash
LLM_MODEL=gemini-3.6-flash

# Set to false to skip the LLM and always use the deterministic engine
LLM_ENABLED=true
